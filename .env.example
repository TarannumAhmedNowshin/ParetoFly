# Copy to .env and fill in real values. .env is git-ignored.

# --- Web search (enrichment) ---
SERPER_API_KEY=
SEARCH_RETRIEVER=googleSerp

# --- Flight offers (primary data source: SerpAPI Google Flights) ---
# The loader also accepts the alias `SerpApi_key`.
SERPAPI_API_KEY=

# --- Google Gemini (single free API key from https://aistudio.google.com/apikey) ---
# The loader also accepts the alias GOOGLE_API_KEY.
GEMINI_API_KEY=
# Quality tier for the narrative / explain node.
GEMINI_FULL_MODEL="gemini-flash-latest"
# Cheap, high-volume tier for intake + per-airline enrichment extraction.
GEMINI_MINI_MODEL="gemini-flash-lite-latest"

# --- Gemini free-tier rate-limit protection ---
# Shared client-side cap across ALL Gemini calls (free tier is ~10-15 RPM).
# Lower this if you still see 429s; raise it on a paid key.
GEMINI_REQUESTS_PER_MINUTE=10
# Exponential-backoff retries on transient 429/5xx before falling back.
GEMINI_MAX_RETRIES=5
GEMINI_TIMEOUT=45

# --- API / CORS (frontend origins allowed to call the API) ---
CORS_ALLOW_ORIGINS="http://localhost:3000"

# --- API hardening ---
# Interactive docs (/docs, /redoc, /openapi.json): off by default; set true for local dev.
ENABLE_DOCS=false
# Hard daily ceiling on LIVE SerpAPI searches (0 = unlimited). Protects the 250/month cap.
SERPAPI_DAILY_BUDGET=0

# --- SerpAPI response cache (protects the 250 searches/month free cap) ---
SERPAPI_CACHE_ENABLED=true
SERPAPI_CACHE_DIR=".cache/serpapi"
SERPAPI_CACHE_TTL_SECONDS=21600
